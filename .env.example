MYSQL_DATABASE=secure_share
MYSQL_USER=secure_share
MYSQL_PASSWORD=replace_with_local_password
MYSQL_ROOT_PASSWORD=replace_with_different_local_root_password
MYSQL_PORT=3306
# URL dành cho backend chạy trực tiếp trên máy. Khi ghép DB layer, đọc từ môi trường.
# Thay password trong URL cho khớp MYSQL_PASSWORD; ký tự đặc biệt cần URL-encode.
DATABASE_URL=mysql+pymysql://secure_share:replace_with_local_password@127.0.0.1:3306/secure_share?charset=utf8mb4
